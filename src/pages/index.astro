---
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';
import Profile from '../components/Profile.astro';
import Socials from '../components/Socials.astro';
---



<Layout title = "Portfolio">
</Layout>
	<section class="intro">
		<h2 class="intro-kicker">Hello, I am David Wagner.</h2>
		<h2 class="intro-title">I program games, explore mechanics and shape immersive experiences.</h2>
		<p class="intro-followup"> 
		As a Gameplay Programmer, I am specialized in development with <span style="font-weight: bold">Unreal Engine</span>, utilizing <span style="font-weight: bold">Blueprint</span> and <span style="font-weight: bold">C++</span>.
		 <span style="font-weight: bold">Clean Code</span>, 
		 <span style="font-weight: bold">Scalability</span> and 
		 <span style="font-weight: bold">Player Satisfaction</span> are my core values.</p>

	</section>
<div class="tab"> 
	<div class="tab-buttons">
		<button data-tab="projects" class="active">Projects</button>
		<button data-tab="prototypesNsystems">Prototypes & Systems</button>
		<button data-tab="about">About me</button> 
	</div>
	
	<div class="tab-content active" id="projects">
		<h2>Projects</h2>
		<ul class="projects-grid">
			<li><Project title="Project Duality" description="Coop adventure puzzle game, with two players controlling opposing forces." date="In Development" link="/Details/ProjectDuality" thumbnail="/images/PD/PDThumb.png" tags={["Unreal Engine", "C++", "Blueprint", "Multiplayer"]}/></li>
			<li><Project title="Soulsworn Manor" description="Dark fantasy terror runner set in a haunted manor." date="March - June 2025" link="/Details/SoulswornManor" thumbnail="/images/SWM/SWM-Thumb.png" tags={["Unreal Engine", "C++", "Blueprint", "State Tree AI", "AI Navigation", "AI Perception"]}/></li>
		</ul>
				<h2 id="Game-Jams">Game Jams</h2>
		<ul class="projects-grid">
			<li><Project title="Breach Protocol" description="Global Game Jam 2026" date="February 2026" link="/Details/BreachProtocol" thumbnail="/images/Breach/BPThumb.png" tags={["Godot", "GDScript", "Multiplayer"]}/></li>
			<li><Project title="Bubble-I-Zation" description="Global Game Jam 2025" date="January 2025" link="/Details/Bubbleization" thumbnail="/images/Bubble/BubbleThumb.jpg" tags={["Godot", "GDScript", "Bubbles"]}/></li>
			<li><Project title="Echoes of the Abyss" description="ÖH Hackathon 2024" date="November 2024" link="/Details/EchoesoftheAbyss" thumbnail="/images/Abyss/AbyssThumb.jpg" tags={["Unity", "C#", "HLSL"]}/></li>
		</ul>
	</div>

	<div class="tab-content" id="prototypesNsystems" hidden>
		<h2 id="prototypes">Prototypes</h2>
		<ul class="projects-grid">
			<li><Project title="Paragon Fighters" description="2D Fighter prototype made in 3D space with Unreal Engine to learn animation control and improve capabilities in C++" date="May 2025" link="/Details/ParagonFighters" thumbnail="/images/PrototypesNSystems/ParagonFighter.png" tags={["UE","C++", "Animation Control", "Anim Notifier"]}/></li>
		</ul>
		<h2 id="systems">Systems</h2>
		<ul class="projects-grid">
			<li><Project title="Navigation Bar" description="Compass bar including markers for game UI." date="October 2025" link="/Details/NavigationBar" thumbnail="/images/PrototypesNSystems/Navigation.png" tags={["UE","C++", "Slate", "UI"]}/></li>
			<li><Project title="Smartphone System" description="In-game smartphone UI hosting multiple functionalities." date="September 2025" link="/Details/SmartphoneSystem" thumbnail="/images/PrototypesNSystems/Smartphone.png" tags={["UE","Blueprint", "CommonUI"]}/></li>
		<!--- 
			<li><Project title="Junk loading" description="Compartmentalization of background elements, coupled with dynamic loading and unloading." date="September 2025" link="#" tags={["UE","Blueprint", "Optimization"]}/></li>
		-->	
		</ul>
	</div>

	<div class="tab-content" id="about" hidden>
		<h2>About Me</h2>
		<div style="display: flex; flex-direction: column; gap: 16px;">
				<Profile name="David Wagner", 
				jobTitle="Game Programmer",
				description={[
				"I develop games since 2023, starting with Unity. In 2024, I have discovered Unreal Engine for myself and have been specializing in it ever since.",
				"During these years I have gradually built a foundation of knowledge and participated in multiple projects as well as in the production of an unanounced title.",
				"My focus lies in gameplay programming, with a particular interest in multiplayer and scalable game systems.",
				"I enjoy working with others that share the same passion and I am happy to help my colleagues by sharing my knowledge, while in turn also learning from them." 
				]}
				
				image="/images/DavidWagnerProfile.png"
				resumeImage="/images/DavidWagnerCV.jpg" resumeDownload="/images/DavidWagnerCV.pdf" resumeAlt="Resumee preview",
				engines ={["Unreal Engine 5", "Unity", "Godot"]},
				skills={["Multiplayer Programming", "Slate", "Animation Control", "State Tree AI", "AI Perception", "AI Navigation", "Common UI", "PCG", "EQS", "State Machines", "Save Games", "Version Control", "Optimization",]},
				languages={["Blueprint","C++", "C#", "GDScript", "HTML", "CSS", ]},
				softskills={["Teamwork", "Communication", "Problem Solving", "Attention to Detail", "Fast learning", "Adaptability", ]}/>
			</div>
		</div>
	</div>
	<Socials/>

<!-- JavaScript for tab functionality -->
<script>

	document.addEventListener('DOMContentLoaded', () => {
		const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-buttons button');
		const tabContents = document.querySelectorAll<HTMLElement>('.tab-content');

		const getTabFromUrl = () => {
			const url = new URL(window.location.href);
			return url.searchParams.get('tab') || 'projects';
		};

		const updateUrl = (tabId: string) => {
			const url = new URL(window.location.href);
			url.searchParams.set('tab', tabId);
			url.searchParams.delete('scroll');
			window.history.pushState({ tab: tabId }, '', url.toString());
		};

		const activateTab = (tabId: string, syncUrl = true) => {
			tabButtons.forEach(btn => btn.classList.remove('active'));
			tabContents.forEach(content => {
				content.classList.remove('active');
				content.hidden = true;
			});

			const activeButton = document.querySelector<HTMLButtonElement>(`.tab-buttons button[data-tab="${tabId}"]`);
			const activeContent = document.getElementById(tabId);

			if (activeButton) {
				activeButton.classList.add('active');
			}
			if (activeContent) {
				activeContent.classList.add('active');
				activeContent.hidden = false;
			}

			if (syncUrl) {
				updateUrl(tabId);
			}
		};

		tabButtons.forEach(button => {
			button.addEventListener('click', () => {
				const tab = button.dataset.tab as string;
				activateTab(tab);
			});
		});

		const url = new URL(window.location.href);
		const tabParam = url.searchParams.get('tab');
		const scrollTarget = url.searchParams.get('scroll') || (url.hash ? url.hash.slice(1) : null);
		const initialTab = tabParam || 'projects';

		if (tabParam) {
			activateTab(tabParam, false);
		} else {
			activateTab(initialTab, false);
		}

		if (scrollTarget) {
			if (!tabParam) activateTab(initialTab, false);
			window.scrollTo({ top: 0, behavior: 'auto' });
			setTimeout(() => {
				const targetElement = document.getElementById(scrollTarget);
				if (targetElement) {
					targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
			}, 80);
		}

		window.addEventListener('popstate', () => {
			activateTab(getTabFromUrl(), false);
		});
	});
</script>